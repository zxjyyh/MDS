# 内业管理系统 — 后端本地运行配置模板
# 仅用于直接运行 server.exe / go run 的场景。
# Docker 部署请使用项目根目录的 .env.example。
#
# 复制为 .env 并修改对应值。
# 注意：.env 是**只读**的，程序任何时候都不会写回它。

PORT=3000
NODE_ENV=production
DATABASE_URL=./data/data.db

# JWT 密钥 — 留空则首次启动自动生成随机值，并持久化到
# <DATABASE_URL 所在目录>/.secrets.env（不是写回本文件）。
# 想固定密钥就填在这里（或 compose 的 environment）。
JWT_SECRET=
JWT_REFRESH_SECRET=

# 初始管理员密码，仅首次初始化数据库时生效
# 留空则自动生成随机密码并打印到控制台
ADMIN_INIT_PASSWORD=

# 理工报名材料的「收件人」默认值（留空则不预填，界面每次手填）
LIGONG_DEFAULT_RECEIVER=

UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=52428800
FRONTEND_DIR=./web/dist

# 允许跨域的来源，多个用逗号分隔；留空表示不限制
CORS_ORIGINS=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

APP_URL=http://localhost:3000
