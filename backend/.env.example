# 内业管理系统 — 后端本地运行配置模板
# 仅用于直接运行 server.exe / go run 的场景。
# Docker 部署请使用项目根目录的 .env.example。
#
# 复制为 .env 并修改对应值。首次启动若 .env 不存在，
# 程序会自动生成含随机 JWT 密钥的 .env。

PORT=3000
NODE_ENV=production
DATABASE_URL=./data/data.db

# JWT 密钥 — 留空则首次启动自动生成随机值并写回 .env
JWT_SECRET=
JWT_REFRESH_SECRET=

# 初始管理员密码，仅首次初始化数据库时生效
# 留空则自动生成随机密码并打印到控制台
ADMIN_INIT_PASSWORD=

UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=52428800
FRONTEND_DIR=./web/dist

# 允许跨域的来源，多个用逗号分隔；留空表示不限制
CORS_ORIGINS=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

APP_URL=http://localhost:3000
