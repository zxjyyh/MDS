# ===== 依赖 =====
node_modules/

# ===== 构建产物 =====
dist/
build/
coverage/
*.tsbuildinfo

# vite.config.ts 的编译产物（Vite 会优先读 .js，保留会导致改 .ts 不生效）
frontend/vite.config.js
frontend/vite.config.d.ts
# unplugin 自动生成的类型声明
frontend/auto-imports.d.ts
frontend/components.d.ts

# ===== 二进制 =====
*.exe
# 必须带前导斜杠锚定仓库根。写成裸 `server` 会匹配任意层级的同名目录，
# 把 backend/cmd/server/ 整个吞掉，导致 clone 下来的代码无法编译。
/backend/server
/server
*.zip

# ===== 密钥与配置 =====
.env
.env.*
!.env.example
# 运行时自动生成的 JWT 密钥文件（位于数据库同级目录）
.secrets.env
**/.secrets.env
# 例外：backend/.env.example 是安全模板（无密钥），允许入库供本地 go run 使用
!backend/.env.example

# ===== 运行时数据 =====
# 说明：这里用 `dir/*` 而不是 `dir/`。
# 若整个目录被排除，Git 不会遍历其内容，下面的 .gitkeep 例外将失效。
data/*
uploads/*
logs/*
backups/*
!data/.gitkeep
!uploads/.gitkeep
!logs/.gitkeep
!backups/.gitkeep

# 其他层级的运行时目录整体排除（关键：backend/uploads 存放真实业务文件）
backend/data/
backend/uploads/
backend/logs/
# 数据备份：本地跑后端时默认落在 backend/backups（进程工作目录是 backend/）
backend/backups/
# 本地 Windows 构建时把前端产物复制到此目录，属构建产物不应入库
/backend/web/dist/

# 兜底：任何位置的数据库和日志文件
*.db
*.db-shm
*.db-wal
*.log

# ===== 编辑器 / 系统 =====
.idea/
.vscode/
.DS_Store
Thumbs.db

# 编辑器/工具产生的备份文件（例如 go build 覆盖 server.exe 时留下的 server.exe~，
# 它 21MB 且 *.exe 规则匹配不到 "server.exe~"，不加这条会被提交进仓库）
*~

# ===== 本地临时产物（严禁入库）=====
# _preview_*：生成的报名材料样例与界面截图，**含真实人员姓名/身份证号/手机号**，
#             以及内部公司信息。推送到公共仓库等同于泄露个人信息，务必排除。
# _tmp_*    ：一次性调试脚本（可能硬编码过 JWT 密钥等）
# _chk*.txt ：本地检查/诊断输出
_preview_*/
_tmp_*/
_chk*.txt
# _prepush_* / _fix_*：推送前审查与批量修复脚本，**通常硬编码了敏感词清单**
#                     （真实姓名、公司名、区号），曾因此差点被提交进仓库
_prepush_*
_fix_*
# 根目录下的一次性 python 脚本（本地工具产物，不属于项目代码）
/_*.py

# ===== 工具目录 =====
.workbuddy/
