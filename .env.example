# 内业管理系统 — 环境配置模板（可选）
# 仅当你想覆盖 docker-compose.nas.yml / docker-compose.yml 里的默认值时才需要：
#   cp .env.example .env   然后改 .env
# NAS 部署默认【不需要】此文件，docker-compose.nas.yml 已内置全部默认值。
# .env 已被 .gitignore 忽略，不会提交到仓库。

# ============ 部署 ============
# 宿主机映射端口（容器内固定 3000）
HOST_PORT=13000
# 容器名，同一台机器跑多套时改这里
CONTAINER_NAME=mds
# 时区。必须设置：到期提醒按本地时间 08:30 触发，
# 留空会退化成 UTC，实际在北京时间 16:30 才发。
TZ=Asia/Shanghai

# 以哪个宿主机用户的身份写文件（NAS 部署强烈建议设置）。
# 在 NAS 的 SSH 终端执行 `id -u` 和 `id -g` 获取，例如群晖常见为 1026 / 100。
# 设为 0 表示以 root 运行（不推荐：生成的文件在 NAS 文件管理器里删不掉）。
PUID=1000
PGID=1000

# ============ JWT 密钥 ============
# 留空时程序会自动生成随机密钥并保存到 data/.secrets.env，重启后保持不变，
# 因此不填也能正常用。想要多实例共享登录态或自行管理密钥时才需要手动指定。
#
# 生成方式（任选其一）：
#   Linux/macOS/NAS   : openssl rand -hex 32
#   Windows PowerShell: -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
# 两个密钥请使用不同的值。更换密钥会导致所有已登录用户被强制登出。
JWT_SECRET=
JWT_REFRESH_SECRET=

# ============ 初始管理员密码 ============
# 仅在数据库首次初始化（users 表为空）时生效。
# 留空则自动生成随机密码并打印到容器日志：docker compose logs mds | grep 初始
ADMIN_INIT_PASSWORD=

# ============ 上传 ============
UPLOAD_MAX_SIZE=52428800

# ============ 跨域 ============
# 前后端同源部署（默认的单容器模式）请保持留空 —— 留空表示完全不下发 CORS 头，最安全。
# 确需跨域时填写精确来源，多个用逗号分隔：
#   CORS_ORIGINS=http://192.168.1.10:13000,https://mds.example.com
# 填 * 表示允许任意来源但禁止携带凭证。
CORS_ORIGINS=

# 若部署在 Nginx / 反向代理之后，填写代理的 IP 或网段，否则 ClientIP 取不到真实来源，
# 登录限流会把所有人算成同一个 IP。留空表示不信任任何代理（直连场景保持留空）。
# TRUSTED_PROXIES=172.16.0.0/12

# ============ SMTP 邮件（可选）============
# 留空则不发送到期提醒。也可以在系统的「提醒设置」页面里配置，
# 页面里保存的值存进数据库，优先级高于这里。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 提醒邮件里的访问链接，部署后改成实际地址，例如 http://192.168.1.10:13000
APP_URL=http://localhost:13000

# 到期检查的执行时间（cron 表达式，默认每天 08:30）
# REMINDER_CRON=30 8 * * *

# ============ 日志 ============
# LOG_MAX_SIZE_MB=10
# LOG_MAX_BACKUPS=5
# LOG_MAX_AGE_DAYS=30

# ============ 镜像 ============
# docker-compose.nas.yml 使用。改成你自己 fork 后的镜像地址即可。
IMAGE_NAME=ghcr.io/zxjyyh/mds:latest
